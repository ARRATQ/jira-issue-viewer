# === BASE DE DONNÉES ===
# DATABASE_URL n'est PAS à définir ici : docker-compose.yml la construit
# automatiquement pour le service backend à partir des 3 valeurs
# ci-dessous (avec `db` comme host, le nom du service dans le réseau
# Docker interne). Ne jamais ajouter de variable DATABASE_URL séparée
# (notamment dans Coolify) : elle entrerait en conflit.
# DB_PASSWORD : uniquement alphanumérique (pas de @ / : # % etc., qui
# casseraient l'URL de connexion générée) — ex. openssl rand -hex 24
DB_NAME=jira_issue_viewer
DB_USER=jivuser
DB_PASSWORD=changeme_db_password

# === SÉCURITÉ JWT (générer avec : openssl rand -hex 32) ===
JWT_SECRET=changeme_jwt_secret_32chars_minimum_here
JWT_REFRESH_SECRET=changeme_refresh_secret_32chars_min

# === CHIFFREMENT AU REPOS (AppConfig.jira_pat) — générer avec : openssl rand -hex 32 ===
ENCRYPTION_KEY=changeme_64_hex_chars_32_bytes_key_here

# === JIRA DATA CENTER ===
JIRA_URL=https://your-jira-instance/jira
JIRA_PAT=changeme_jira_personal_access_token
# JQL global initial (modifiable ensuite par l'admin via l'app)
JIRA_JQL=project = PROJ AND issuetype = Task ORDER BY created DESC
# false = certificat interne/auto-signé ; true = certificat public valide (par défaut si omis)
JIRA_TLS_REJECT_UNAUTHORIZED=false

# === APPLICATION ===
APP_PORT=8070
BACKEND_PORT=3001
APP_ORIGIN=http://localhost:8070
NODE_ENV=production

# === COMPTE ADMIN INITIAL (seedé au premier démarrage) ===
ADMIN_EMAIL=admin@example.com
# Politique de mot de passe (appliquée aussi à la création/modification de
# comptes et au changement de mot de passe dans l'app) : 10 caractères
# minimum, avec majuscule, minuscule, chiffre et caractère spécial.
ADMIN_PASSWORD=Changeme_1234!
ADMIN_NAME=Administrateur
