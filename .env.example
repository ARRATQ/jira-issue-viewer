# === BASE DE DONNÉES ===
DB_NAME=jira_issue_viewer
DB_USER=jivuser
DB_PASSWORD=changeme_db_password
DATABASE_URL=postgresql://jivuser:changeme_db_password@localhost:5432/jira_issue_viewer

# === SÉCURITÉ JWT (générer avec : openssl rand -hex 32) ===
JWT_SECRET=changeme_jwt_secret_32chars_minimum_here
JWT_REFRESH_SECRET=changeme_refresh_secret_32chars_min

# === JIRA DATA CENTER ===
JIRA_URL=https://your-jira-instance/jira
JIRA_PAT=changeme_jira_personal_access_token
# JQL global initial (modifiable ensuite par l'admin via l'app)
JIRA_JQL=project = PROJ AND issuetype = Task ORDER BY created DESC
# false = certificat interne/auto-signé (par défaut) ; true = certificat public valide
JIRA_TLS_REJECT_UNAUTHORIZED=false
# Optionnel : chemin vers un CA interne, alternative à JIRA_TLS_REJECT_UNAUTHORIZED=false
# JIRA_CA_CERT=/path/to/internal-ca.pem

# === APPLICATION ===
APP_PORT=8080
BACKEND_PORT=3001
APP_ORIGIN=http://localhost:8080
VITE_API_URL=http://localhost:3001
NODE_ENV=production

# === COMPTE ADMIN INITIAL (seedé au premier démarrage) ===
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme_admin_password
ADMIN_NAME=Administrateur
