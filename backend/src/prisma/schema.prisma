generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String
  role         Role       @default(USER)
  active       Boolean    @default(true)
  // Force l'utilisateur à définir son propre mot de passe à la prochaine
  // connexion. Positionné à true quand un admin crée le compte ou réinitialise
  // le mot de passe (mot de passe temporaire), remis à false dès que
  // l'utilisateur change lui-même son mot de passe.
  mustChangePassword Boolean @default(false)
  auditLogs    AuditLog[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// Stockage clé/valeur générique : jira_url, jira_pat (encrypted=true), jql
model AppConfig {
  key       String   @id
  value     String   @db.Text
  encrypted Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String?
  entityKey  String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// Une requête JQL nommée, avec sa propre configuration d'affichage
// (colonnes de liste + onglets de détail). Structures toujours lues/écrites
// en bloc (jamais interrogées champ par champ en SQL) : stockage en Json,
// même pattern que Program.categories/intCriteria dans le projet de
// référence "referencement" plutôt qu'un éclatement en tables relationnelles.
model SavedQuery {
  id          String   @id @default(uuid())
  name        String
  jql         String   @db.Text
  position    Int      @default(0)
  // [{ fieldId, fieldName }, ...] — colonnes/filtres affichés dans la liste,
  // en plus de Clé/Résumé/Statut/Type.
  listColumns Json     @default("[]")
  // [{ id, label, position, visibleToUser, fields: [{ fieldId, fieldName }] }, ...]
  // L'onglet système "Autres" (champs non mappés) n'est jamais stocké ici :
  // seule sa visibilité par rôle l'est, via autresVisibleToUser.
  tabs        Json     @default("[]")
  autresVisibleToUser Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([position])
}
